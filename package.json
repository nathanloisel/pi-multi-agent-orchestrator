		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"pi": {
		"extensions": ["./index.ts"]
	}
